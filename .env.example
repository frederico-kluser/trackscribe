# Required: OpenAI API key used for whisper-1 transcription.
OPENAI_API_KEY=sk-replace-me

# Optional: Hugging Face token. ONLY needed for --diarize (WhisperX + the gated
# pyannote models). Create one at https://huggingface.co/settings/tokens AFTER
# accepting the pyannote model terms (see the README "Diarization" section).
# HF_TOKEN=hf_replace-me
