# Required: OpenAI API key used for whisper-1 transcription.
OPENAI_API_KEY=sk-replace-me

# Required ONLY for --diarize: pyannoteAI API key (cloud diarization, model precision-2).
# Create one at https://dashboard.pyannote.ai (free trial credits included).
# PYANNOTEAI_API_KEY=replace-me

# Optional: override the pyannoteAI base URL (defaults to https://api.pyannote.ai/v1).
# PYANNOTEAI_BASE_URL=https://api.pyannote.ai/v1
